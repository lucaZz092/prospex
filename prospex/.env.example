# Só para o WORKER (nunca coloque a service role no front-end nem no git)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Motor de busca. Padrão: ../softsolutions_prospeccao/google-maps-scraper-kit dentro deste repositório.
# PROSPEX_KIT=/caminho/para/google-maps-scraper-kit
PROSPEX_DEPTH=3

# Garantia de volume: devolução automática pelo Mercado Pago (o mesmo token das Edge Functions)
MP_ACCESS_TOKEN=

# Aviso de "lista pronta" por e-mail (resend.com; o domínio do remetente precisa estar verificado lá)
RESEND_API_KEY=
EMAIL_FROM=Prospex <avisos@SEU-DOMINIO.com.br>
SITE_URL=https://SEU-DOMINIO.com.br

# Só para testes locais: leads fictícios em vez de busca real. Nunca em produção.
